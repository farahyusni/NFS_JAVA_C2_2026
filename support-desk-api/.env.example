# Support Desk API - copy this file to .env and fill in real local values.
# Never commit the real .env file.

# ===== JWT =====
JWT_SECRET=replace-with-a-long-random-local-dev-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=60

# ===== MongoDB =====
# Use host.docker.internal (not localhost) so the container can reach MongoDB
# running on your machine, not inside the container itself.
MONGO_HOST=host.docker.internal
MONGO_PORT=27017
MONGO_DATABASE=support_desk_db
MONGO_USERNAME=app_user
MONGO_PASSWORD=abc123
MONGO_AUTH_DATABASE=support_desk_db

# ===== Ports (used by compose.support-desk.yaml) =====
BACKEND_PORT=8080
FRONTEND_PORT=5173
MONGO_HOST_PORT=27018